# Normalize line endings: store LF in the repo, adapt on checkout
* text=auto

# Force LF for shell scripts, CRLF for Windows batch files
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (don't diff or transform)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
